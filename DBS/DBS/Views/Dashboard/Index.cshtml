@model DBS.ViewModels.DashboardViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" />
}

<div class="dashboard-header">
    <h1>Dashboard</h1>
    <p>Visão geral do sistema</p>
</div>

<div class="cards-grid">
    <div class="metric-card">
        <span class="metric-label">Receita do Mês</span>
        <span class="metric-value">R$ @Model.ReceitaMes.ToString("N2")</span>
        <span class="metric-delta positivo">↑ Pedidos pagos no mês atual</span>
    </div>
    <div class="metric-card">
        <span class="metric-label">Clientes Ativos</span>
        <span class="metric-value">@Model.TotalClientesAtivos</span>
        <span class="metric-delta positivo">↑ Total cadastrado</span>
    </div>
    <div class="metric-card">
        <span class="metric-label">Ordens Abertas</span>
        <span class="metric-value">@Model.TotalOrdensAbertas</span>
        <span class="metric-delta negativo">↓ Pendentes de ação</span>
    </div>
    <div class="metric-card">
        <span class="metric-label">Produtos em Estoque</span>
        <span class="metric-value">@Model.TotalProdutosEstoque</span>
        <span class="metric-delta positivo">↑ Unidades disponíveis</span>
    </div>
</div>

<div class="dashboard-row">
    <div class="painel">
        <h3 class="painel-titulo">Últimas Ordens</h3>
        <table class="tabela">
            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Cliente</th>
                    <th>Valor</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.UltimasOrdens.Any())
                {
                    <tr>
                        <td colspan="4" style="text-align:center; color:#888;">Nenhuma ordem encontrada.</td>
                    </tr>
                }
                @foreach (var ordem in Model.UltimasOrdens)
                {
                    <tr>
                        <td class="mono">#@ordem.Id</td>
                        <td>@ordem.ClienteNome</td>
                        <td>R$ @ordem.ValorTotal.ToString("N2")</td>
                        <td>
                            <span class="status @(ordem.Status?.ToLower() == "pago" ? "pago" : "pendente")">
                                @ordem.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
