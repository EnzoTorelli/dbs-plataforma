@model List<DBS.Models.Pedido>
@{
    ViewData["Title"] = "Ordens";
    ViewData["Pagina"] = "Ordens";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ordens.css" />
}

<div class="page-wrap">

    <div class="page-header">
        <div>
            <br>
            <h1>Ordens</h1>
            <span>Gerenciamento de pedidos</span>
            <p>
        </div>
        <button class="btn-novo" onclick="abrirModal()">+ Nova Ordem</button>
    </div>

    <div class="barra-busca">
        <input type="text" id="campoBusca" placeholder="Buscar pedido..." oninput="filtrarTabela()" />
        <select id="filtroStatus" onchange="filtrarTabela()">
            <option value="">Todos</option>
            <option value="pendente">Pendente</option>
            <option value="pago">Pago</option>
            <option value="cancelado">Cancelado</option>
        </select>
    </div>

    <div class="painel">
        <table class="tabela" id="tabelaOrdens">
            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Cliente</th>
                    <th>Data</th>
                    <th>Valor</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; color:#888;">Nenhuma ordem encontrada.</td>
                    </tr>
                }
                @foreach (var ordem in Model)
                {
                    <tr>
                        <td>#@ordem.Id</td>
                        <td>@ordem.ClienteNome</td>
                        <td>@(ordem.DataPedido != DateTime.MinValue ? ordem.DataPedido.ToString("dd/MM/yyyy") : "—")</td>
                        <td>R$ @ordem.ValorTotal.ToString("N2")</td>
                        <td>
                            <span class="status @(ordem.Status?.ToLower() ?? "pendente")">
                                @(ordem.Status ?? "Pendente")
                            </span>
                        </td>
                        <td>
                            <button class="btn-acao editar" onclick="abrirModalEditar(@ordem.Id)">Editar</button>
                            <form method="post" asp-action="Excluir" asp-route-id="@ordem.Id" style="display:inline"
                                  onsubmit="return confirm('Excluir ordem #@ordem.Id?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-acao excluir">Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- Modal de Cadastro -->
<div class="modal-overlay" id="modalOrdem">
    <div class="modal">
        <div class="modal-header">
            <h2>Nova Ordem</h2>
            <button type="button" class="modal-fechar" onclick="fecharModal()">×</button>
        </div>

        <form method="post" asp-action="Salvar">
            @Html.AntiForgeryToken()

            <div class="form-grupo">
                <label>ID do Cliente</label>
                <input type="number" name="IdCliente" placeholder="Ex: 1" />
            </div>

            <div class="form-grupo">
                <label>Valor (R$)</label>
                <input type="number" name="Valor" placeholder="0,00" step="0.01" />
            </div>

            <div class="form-grupo">
                <label>Status</label>
                <select name="Status">
                    <option value="Pendente">Pendente</option>
                    <option value="Pago">Pago</option>
                    <option value="Cancelado">Cancelado</option>
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancelar" onclick="fecharModal()">Cancelar</button>
                <button type="submit" class="btn-salvar">Salvar Ordem</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal de Edição -->
<div class="modal-overlay" id="modalEditar">
    <div class="modal">
        <div class="modal-header">
            <h2>Editar Ordem</h2>
            <button type="button" class="modal-fechar" onclick="fecharModalEditar()">×</button>
        </div>

        <form method="post" asp-action="Atualizar">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editarId" />

            <div class="form-grupo">
                <label>ID do Cliente</label>
                <input type="number" name="IdCliente" id="editarIdCliente" />
            </div>

            <div class="form-grupo">
                <label>Valor (R$)</label>
                <input type="number" name="Valor" id="editarValor" step="0.01" />
            </div>

            <div class="form-grupo">
                <label>Status</label>
                <select name="Status" id="editarStatus">
                    <option value="Pendente">Pendente</option>
                    <option value="Pago">Pago</option>
                    <option value="Cancelado">Cancelado</option>
                </select>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancelar" onclick="fecharModalEditar()">Cancelar</button>
                <button type="submit" class="btn-salvar">Salvar Alterações</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModal() {
            document.getElementById('modalOrdem').classList.add('aberto');
        }
        function fecharModal() {
            document.getElementById('modalOrdem').classList.remove('aberto');
        }
        document.getElementById('modalOrdem').addEventListener('click', function (e) {
            if (e.target === this) fecharModal();
        });

        function abrirModalEditar(id) {
            fetch(`/Ordens/Editar/${id}`)
                .then(r => r.json())
                .then(o => {
                    document.getElementById('editarId').value        = o.id;
                    document.getElementById('editarIdCliente').value = o.idCliente ?? '';
                    document.getElementById('editarValor').value     = o.valorTotal;
                    document.getElementById('editarStatus').value    = o.status ?? 'Pendente';
                    document.getElementById('modalEditar').classList.add('aberto');
                });
        }
        function fecharModalEditar() {
            document.getElementById('modalEditar').classList.remove('aberto');
        }
        document.getElementById('modalEditar').addEventListener('click', function (e) {
            if (e.target === this) fecharModalEditar();
        });

        function filtrarTabela() {
            const termo = document.getElementById('campoBusca').value.toLowerCase();
            const status = document.getElementById('filtroStatus').value.toLowerCase();
            const linhas = document.querySelectorAll('#tabelaOrdens tbody tr');
            linhas.forEach(linha => {
                const textoOk = linha.textContent.toLowerCase().includes(termo);
                const statusOk = status === '' || linha.textContent.toLowerCase().includes(status);
                linha.style.display = textoOk && statusOk ? '' : 'none';
            });
        }
    </script>
}