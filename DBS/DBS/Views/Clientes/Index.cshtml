@model List<DBS.Models.Cliente>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Clientes";
    ViewData["Pagina"] = "Clientes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/clientes.css" />
    <style>
        .form-grupo input.invalido {
            border-color: #dc2626;
            box-shadow: 0 0 0 3px rgba(220, 38, 38, .12);
        }

        .erro-campo {
            display: block;
            min-height: 16px;
            margin-top: 4px;
            font-size: 12px;
            color: #dc2626;
        }

        .obrigatorio {
            color: #dc2626;
        }

        .alerta {
            margin: 0 0 16px;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 14px;
        }

            .alerta ul {
                margin: 6px 0 0 18px;
                padding: 0;
            }

        .alerta-erro {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .alerta-sucesso {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
        }

        /* Modais mais compactos, mantendo o estilo atual */
        .modal {
            width: min(560px, calc(100vw - 32px));
            max-height: calc(100vh - 32px);
            overflow-y: auto;
        }

            .modal .modal-header {
                padding: 14px 20px;
            }

            .modal form {
                padding: 16px 20px;
            }

            .modal .form-grupo {
                margin-bottom: 10px;
            }

            .modal .form-linha {
                gap: 12px;
            }
    </style>
}

<div class="page-wrap">

    <div class="page-header">
        <div>
            <br>
            <h1>Clientes</h1>
            <span>Gerencie as empresas cadastradas</span>
        </div>
        <button class="btn-novo" onclick="abrirModal()">+ Nova Empresa</button>
    </div>

    @if (TempData["Erro"] is string erro)
    {
        <div class="alerta alerta-erro">
            <strong>Não foi possível salvar:</strong>
            <ul>
                @foreach (var msg in erro.Split('|'))
                {
                    <li>@msg</li>
                }
            </ul>
        </div>
    }

    @if (TempData["Sucesso"] is string sucesso)
    {
        <div class="alerta alerta-sucesso">@sucesso</div>
    }

    <div class="barra-busca">
        <input type="text" id="campoBusca"
               placeholder="Buscar por empresa, CNPJ, e-mail ou telefone..."
               oninput="filtrarTabela()" />
    </div>

    <div class="painel">
        <table class="tabela" id="tabelaClientes">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Razão Social</th>
                    <th>Nome Fantasia</th>
                    <th>E-mail</th>
                    <th>Telefone</th>
                    <th>CNPJ</th>
                    <th>Cadastro</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" style="text-align:center; color:#888;">
                            Nenhuma empresa cadastrada.
                        </td>
                    </tr>
                }

                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Id</td>
                        <td>@cliente.RazaoSocial</td>
                        <td>@(cliente.NomeFantasia ?? "—")</td>
                        <td>@(cliente.Email ?? "—")</td>
                        <td>@(cliente.Telefone ?? "—")</td>
                        <td>@(cliente.Cnpj ?? "—")</td>
                        <td>@cliente.DataCadastro.ToString("dd/MM/yyyy")</td>
                        <td>
                            <button class="btn-acao editar"
                                    onclick="abrirModalEditar(@cliente.Id)">
                                Editar
                            </button>

                            <form method="post" asp-action="Excluir"
                                  asp-route-id="@cliente.Id"
                                  style="display:inline"
                                  onsubmit="return confirm('Excluir empresa @cliente.RazaoSocial?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-acao excluir">
                                    Excluir
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal de Cadastro -->
<div class="modal-overlay" id="modalCliente">
    <div class="modal">
        <div class="modal-header">
            <h2>Nova Empresa</h2>
            <button type="button" class="modal-fechar" onclick="fecharModal()">×</button>
        </div>

        <form method="post" asp-action="Salvar" id="formNovo" data-cliente novalidate>
            @Html.AntiForgeryToken()

            <div class="form-grupo">
                <label>Razão Social <span class="obrigatorio">*</span></label>
                <input type="text" name="RazaoSocial"
                       placeholder="Nome empresarial"
                       maxlength="150" data-validar />
                <span class="erro-campo"></span>
            </div>

            <div class="form-grupo">
                <label>Nome Fantasia</label>
                <input type="text" name="NomeFantasia"
                       placeholder="Nome comercial da empresa"
                       maxlength="150" />
            </div>

            <div class="form-linha">
                <div class="form-grupo">
                    <label>CNPJ <span class="obrigatorio">*</span></label>
                    <input type="text" name="Cnpj"
                           placeholder="00.000.000/0000-00"
                           autocomplete="off" maxlength="18"
                           data-mask="cnpj" data-validar />
                    <span class="erro-campo"></span>
                </div>

                <div class="form-grupo">
                    <label>Responsável <span class="obrigatorio">*</span></label>
                    <input type="text" name="Responsavel"
                           placeholder="Nome do responsável"
                           maxlength="150" data-validar />
                    <span class="erro-campo"></span>
                </div>
            </div>

            <div class="form-linha">
                <div class="form-grupo">
                    <label>Telefone <span class="obrigatorio">*</span></label>
                    <input type="text" name="Telefone"
                           placeholder="(00) 00000-0000"
                           autocomplete="off" maxlength="15"
                           data-mask="telefone" data-validar />
                    <span class="erro-campo"></span>
                </div>

                <div class="form-grupo">
                    <label>Celular</label>
                    <input type="text" name="Celular"
                           placeholder="(00) 00000-0000"
                           autocomplete="off" maxlength="15"
                           data-mask="telefone" />
                </div>
            </div>

            <div class="form-grupo">
                <label>E-mail <span class="obrigatorio">*</span></label>
                <input type="email" name="Email"
                       placeholder="email@empresa.com"
                       maxlength="150" data-validar />
                <span class="erro-campo"></span>
            </div>

            <div class="form-linha">
                <div class="form-grupo">
                    <label>CEP</label>
                    <input type="text" name="Cep"
                           placeholder="00000-000" maxlength="9" data-mask="cep" />
                </div>

                <div class="form-grupo">
                    <label>Número</label>
                    <input type="text" name="Numero"
                           placeholder="Número" maxlength="20" />
                </div>
            </div>

            <div class="form-grupo">
                <label>Logradouro</label>
                <input type="text" name="Logradouro"
                       placeholder="Rua, avenida, etc."
                       maxlength="150" />
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancelar" onclick="fecharModal()">
                    Cancelar
                </button>
                <button type="submit" class="btn-salvar">
                    Salvar Empresa
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal de Edição -->
<div class="modal-overlay" id="modalEditar">
    <div class="modal">
        <div class="modal-header">
            <h2>Editar Empresa</h2>
            <button type="button" class="modal-fechar" onclick="fecharModalEditar()">×</button>
        </div>

        <form method="post" asp-action="Atualizar" id="formEditar" data-cliente novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editarId" />

            <div class="form-grupo">
                <label>Razão Social <span class="obrigatorio">*</span></label>
                <input type="text" name="RazaoSocial" id="editarRazaoSocial"
                       maxlength="150" data-validar />
                <span class="erro-campo"></span>
            </div>

            <div class="form-grupo">
                <label>Nome Fantasia</label>
                <input type="text" name="NomeFantasia"
                       id="editarNomeFantasia" maxlength="150" />
            </div>

            <div class="form-linha">
                <div class="form-grupo">
                    <label>CNPJ <span class="obrigatorio">*</span></label>
                    <input type="text" name="Cnpj" id="editarCnpj"
                           placeholder="00.000.000/0000-00"
                           autocomplete="off" maxlength="18"
                           data-mask="cnpj" data-validar />
                    <span class="erro-campo"></span>
                </div>

                <div class="form-grupo">
                    <label>Responsável <span class="obrigatorio">*</span></label>
                    <input type="text" name="Responsavel"
                           id="editarResponsavel" maxlength="150" data-validar />
                    <span class="erro-campo"></span>
                </div>
            </div>

            <div class="form-linha">
                <div class="form-grupo">
                    <label>Telefone <span class="obrigatorio">*</span></label>
                    <input type="text" name="Telefone" id="editarTelefone"
                           placeholder="(00) 00000-0000"
                           autocomplete="off" maxlength="15"
                           data-mask="telefone" data-validar />
                    <span class="erro-campo"></span>
                </div>

                <div class="form-grupo">
                    <label>Celular</label>
                    <input type="text" name="Celular" id="editarCelular"
                           placeholder="(00) 00000-0000"
                           autocomplete="off" maxlength="15"
                           data-mask="telefone" />
                </div>
            </div>

            <div class="form-grupo">
                <label>E-mail <span class="obrigatorio">*</span></label>
                <input type="email" name="Email" id="editarEmail"
                       placeholder="email@empresa.com"
                       maxlength="150" data-validar />
                <span class="erro-campo"></span>
            </div>

            <div class="form-linha">
                <div class="form-grupo">
                    <label>CEP</label>
                    <input type="text" name="Cep" id="editarCep"
                           placeholder="00000-000" maxlength="9" data-mask="cep" />
                </div>

                <div class="form-grupo">
                    <label>Número</label>
                    <input type="text" name="Numero" id="editarNumero"
                           maxlength="20" />
                </div>
            </div>

            <div class="form-grupo">
                <label>Logradouro</label>
                <input type="text" name="Logradouro"
                       id="editarLogradouro" maxlength="150" />
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancelar" onclick="fecharModalEditar()">
                    Cancelar
                </button>
                <button type="submit" class="btn-salvar">
                    Salvar Alterações
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // ================= Máscaras =================

        function normalizarCnpj(valor) {
            return (valor || '')
                .replace(/[^a-zA-Z0-9]/g, '')
                .toUpperCase()
                .slice(0, 14);
        }

        function formatarCnpj(valor) {
            const cnpj = normalizarCnpj(valor);

            let resultado = '';

            if (cnpj.length > 0)
                resultado += cnpj.slice(0, 2);

            if (cnpj.length > 2)
                resultado += '.' + cnpj.slice(2, 5);

            if (cnpj.length > 5)
                resultado += '.' + cnpj.slice(5, 8);

            if (cnpj.length > 8)
                resultado += '/' + cnpj.slice(8, 12);

            if (cnpj.length > 12)
                resultado += '-' + cnpj.slice(12, 14);

            return resultado;
        }

        function formatarTelefone(valor) {
            const d = (valor || '').replace(/\D/g, '').slice(0, 11);

            if (d.length === 0) return '';
            if (d.length <= 2) return '(' + d;

            if (d.length <= 6)
                return '(' + d.slice(0, 2) + ') ' + d.slice(2);

            if (d.length <= 10)
                return '(' + d.slice(0, 2) + ') ' +
                    d.slice(2, 6) + '-' + d.slice(6);

            return '(' + d.slice(0, 2) + ') ' +
                d.slice(2, 7) + '-' + d.slice(7);
        }

        function formatarCep(valor) {
            const cep = (valor || '').replace(/\D/g, '').slice(0, 8);

            if (cep.length > 5) {
                return cep.slice(0, 5) + '-' + cep.slice(5);
            }

            return cep;
        }

        function aplicarMascaraCampo(input) {
            if (input.dataset.mask === 'cnpj') {
                input.value = formatarCnpj(input.value);
            }

            if (input.dataset.mask === 'telefone') {
                input.value = formatarTelefone(input.value);
            }

            if (input.dataset.mask === 'cep') {
                input.value = formatarCep(input.value);
            }
        }

        document.querySelectorAll('[data-mask]').forEach(input => {
            input.addEventListener('input', () => aplicarMascaraCampo(input));
        });

        // ================= Validação =================

        function cnpjValido(valor) {
            return /^[A-Z0-9]{12}[0-9]{2}$/.test(normalizarCnpj(valor));
        }

        function telefoneValido(valor) {
            const d = (valor || '').replace(/\D/g, '');
            return d.length === 10 || d.length === 11;
        }

        const RX_EMAIL = /^[A-Za-z0-9._%+\-]+@@[A-Za-z0-9\-]+(\.[A-Za-z0-9\-]+)*\.[A-Za-z]{2,}$/;

        function emailValido(valor) {
            valor = valor.trim();
            return valor.length <= 254 &&
                !valor.includes('..') &&
                RX_EMAIL.test(valor);
        }

        function textoValido(valor) {
            return valor.trim().length >= 3;
        }

        const REGRAS = {
            RazaoSocial: {
                valido: textoValido,
                vazio: 'Informe a razão social.',
                invalido: 'Informe pelo menos 3 caracteres.'
            },
            Cnpj: {
                valido: cnpjValido,
                vazio: 'Informe o CNPJ.',
                invalido: 'CNPJ deve ter 12 letras ou números e 2 números finais.'
            },
            Responsavel: {
                valido: textoValido,
                vazio: 'Informe o responsável.',
                invalido: 'Informe pelo menos 3 caracteres.'
            },
            Telefone: {
                valido: telefoneValido,
                vazio: 'Informe o telefone.',
                invalido: 'Informe DDD e número de telefone.'
            },
            Email: {
                valido: emailValido,
                vazio: 'Informe o e-mail.',
                invalido: 'E-mail inválido.'
            }
        };

        function mostrarErro(input, mensagem) {
            input.classList.toggle('invalido', !!mensagem);

            const span = input.parentElement.querySelector('.erro-campo');

            if (span)
                span.textContent = mensagem;
        }

        function validarCampo(input) {
            const regra = REGRAS[input.name];

            if (!regra)
                return true;

            const valor = input.value;
            const mensagem = !valor.trim()
                ? regra.vazio
                : (regra.valido(valor) ? '' : regra.invalido);

            mostrarErro(input, mensagem);
            return !mensagem;
        }

        function validarForm(form) {
            let primeiroInvalido = null;

            form.querySelectorAll('input[data-validar]').forEach(input => {
                if (!validarCampo(input) && !primeiroInvalido)
                    primeiroInvalido = input;
            });

            if (primeiroInvalido)
                primeiroInvalido.focus();

            return !primeiroInvalido;
        }

        function limparErros(form) {
            form.querySelectorAll('input[data-validar]').forEach(input => {
                mostrarErro(input, '');
            });
        }

        document.querySelectorAll('form[data-cliente]').forEach(form => {
            form.addEventListener('submit', event => {
                const email = form.querySelector('[name="Email"]');
                email.value = email.value.trim().toLowerCase();

                form.querySelectorAll('[data-mask]').forEach(input => {
                    aplicarMascaraCampo(input);
                });

                if (!validarForm(form))
                    event.preventDefault();
            });

            form.querySelectorAll('input[data-validar]').forEach(input => {
                input.addEventListener('blur', () => {
                    if (input.value.trim())
                        validarCampo(input);
                });

                input.addEventListener('input', () => {
                    if (input.classList.contains('invalido'))
                        validarCampo(input);
                });
            });
        });

        // ================= Modais =================

        const formNovo = document.getElementById('formNovo');
        const formEditar = document.getElementById('formEditar');

        function abrirModal() {
            formNovo.reset();
            limparErros(formNovo);

            document.getElementById('modalCliente').classList.add('aberto');

            formNovo.querySelector('[name="RazaoSocial"]').focus();
        }

        function fecharModal() {
            document.getElementById('modalCliente').classList.remove('aberto');
        }

        document.getElementById('modalCliente').addEventListener('click', event => {
            if (event.target === event.currentTarget)
                fecharModal();
        });

        async function abrirModalEditar(id) {
            try {
                const resposta = await fetch(`/Clientes/Editar/${id}`);

                if (!resposta.ok)
                    throw new Error('Não foi possível carregar a empresa.');

                const c = await resposta.json();

                limparErros(formEditar);

                document.getElementById('editarId').value = c.id ?? '';
                document.getElementById('editarRazaoSocial').value = c.razaoSocial ?? '';
                document.getElementById('editarNomeFantasia').value = c.nomeFantasia ?? '';
                document.getElementById('editarCnpj').value = formatarCnpj(c.cnpj ?? '');
                document.getElementById('editarResponsavel').value = c.responsavel ?? '';
                document.getElementById('editarTelefone').value = formatarTelefone(c.telefone ?? '');
                document.getElementById('editarCelular').value = formatarTelefone(c.celular ?? '');
                document.getElementById('editarEmail').value = c.email ?? '';
                document.getElementById('editarCep').value = formatarCep(c.cep ?? '');
                document.getElementById('editarNumero').value = c.numero ?? '';
                document.getElementById('editarLogradouro').value = c.logradouro ?? '';

                document.getElementById('modalEditar').classList.add('aberto');
            }
            catch (erro) {
                alert(erro.message);
            }
        }

        function fecharModalEditar() {
            document.getElementById('modalEditar').classList.remove('aberto');
        }

        document.getElementById('modalEditar').addEventListener('click', event => {
            if (event.target === event.currentTarget)
                fecharModalEditar();
        });

        document.addEventListener('keydown', event => {
            if (event.key !== 'Escape')
                return;

            fecharModal();
            fecharModalEditar();
        });

        // ================= Busca =================

        function filtrarTabela() {
            const termo = document.getElementById('campoBusca').value
                .toLowerCase().trim();

            const termoNormalizado = termo.replace(/[^a-z0-9]/g, '');

            document.querySelectorAll('#tabelaClientes tbody tr').forEach(linha => {
                const texto = linha.textContent.toLowerCase();
                const textoNormalizado = texto.replace(/[^a-z0-9]/g, '');

                const achou = texto.includes(termo) ||
                    (termoNormalizado && textoNormalizado.includes(termoNormalizado));

                linha.style.display = achou ? '' : 'none';
            });
        }
    </script>
}
