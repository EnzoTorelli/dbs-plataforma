<!DOCTYPE html>
<html lang="pt-br" data-fonte="2">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — DBS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">

    <script>
            (function () {
                try {
                    var html = document.documentElement;
                    if (localStorage.getItem('acess_escuro') === 'true') html.setAttribute('data-tema', 'escuro');
                    if (localStorage.getItem('acess_contraste') === 'true') html.setAttribute('data-contraste', 'ativo');
                    html.setAttribute('data-fonte', localStorage.getItem('acess_fonte') || '2');
                } catch (_) {}
            })();
    </script>

    <link rel="stylesheet" href="~/css/acessibilidade.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    @await Html.PartialAsync("_BarraAcessibilidade")

    <div class="container-geral">

        <div class="sidebar">
            <div class="sidebar-brand">
                <img src="~/imagens/logo3.png" alt="DBS" class="sidebar-logo" />
                <span class="sidebar-sistema">Sistema de Gestão</span>
            </div>

            <nav>
                <a href="/Dashboard" class="@(ViewData["Pagina"]?.ToString() == "Dashboard" ? "ativo" : "")">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="1" y="1" width="6" height="6" rx="1" />
                        <rect x="9" y="1" width="6" height="6" rx="1" />
                        <rect x="1" y="9" width="6" height="6" rx="1" />
                        <rect x="9" y="9" width="6" height="6" rx="1" />
                    </svg>
                    Dashboard
                </a>
                <a href="/Clientes" class="@(ViewData["Pagina"]?.ToString() == "Clientes" ? "ativo" : "")">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="8" cy="5" r="3" />
                        <path d="M2 14c0-3.3 2.7-6 6-6s6 2.7 6 6" />
                    </svg>
                    Clientes
                </a>
                <a href="/Produtos" class="@(ViewData["Pagina"]?.ToString() == "Produtos" ? "ativo" : "")">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M2 4h12v10H2z" />
                        <path d="M5 4V2h6v2" />
                    </svg>
                    Produtos
                </a>
                <a href="/Vendas" class="@(ViewData["Pagina"]?.ToString() == "Vendas" ? "ativo" : "")">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M1 12 L5 7 L9 9 L15 3" />
                        <polyline points="11,3 15,3 15,7" />
                    </svg>
                    Vendas
                </a>
                <a href="/Ordens" class="@(ViewData["Pagina"]?.ToString() == "Ordens" ? "ativo" : "")">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="1" y="3" width="14" height="11" rx="1" />
                        <path d="M5 3V1h6v2" />
                        <path d="M5 8h6M5 11h4" />
                    </svg>
                    Ordens
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="user-info">
                    <div class="user-avatar">JD</div>
                    <div>
                        <div class="user-nome">Admin</div>
                        <div class="user-cargo">Admin</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="conteudo" id="conteudo-principal">
            @RenderBody()
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/acessibilidade.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- VLibras -->
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
    <script>
        new window.VLibras.Widget('https://vlibras.gov.br/app');
    </script>



</body>
</html>
