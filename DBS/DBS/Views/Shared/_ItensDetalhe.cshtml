@model DBS.Models.Pedido
@using System.Globalization
@*
    Linha escondida logo abaixo do pedido, com a tabela de produtos.
    O número de colunas da tabela principal vem de ViewData["ColspanItens"].
*@
@{
    var ptBR = new CultureInfo("pt-BR");
    var colspan = ViewData["ColspanItens"] as int? ?? 6;
}
@if (Model.Itens.Any())
{
    <tr class="itens-detalhe" id="itens-@Model.Id" hidden>
        <td colspan="@colspan">
            <table class="itens-tabela">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th class="num">Qtd</th>
                        <th class="num">Preço un.</th>
                        <th class="num">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Itens)
                    {
                        <tr>
                            <td>@item.NomeProduto</td>
                            <td class="num">@item.Quantidade</td>
                            <td class="num">R$ @item.PrecoUnitario.ToString("N2", ptBR)</td>
                            <td class="num">R$ @item.Subtotal.ToString("N2", ptBR)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>@Model.TotalUnidades @(Model.TotalUnidades == 1 ? "unidade" : "unidades")</td>
                        <td colspan="2"></td>
                        <td class="num">R$ @Model.Itens.Sum(i => i.Subtotal).ToString("N2", ptBR)</td>
                    </tr>
                </tfoot>
            </table>
        </td>
    </tr>
}
