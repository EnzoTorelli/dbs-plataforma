@model List<DBS.Models.Produto>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Produtos";
    ViewData["Pagina"] = "Produtos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/produtos.css" />
}

<div class="page-wrap">

    <div class="page-header">
        <div>
            <br>
            <h1>Produtos</h1>
            <span>Gerencie o catálogo de produtos</span>
            <p>
        </div>
        <button class="btn-novo" onclick="abrirModal()">+ Novo Produto</button>
    </div>

    <div class="barra-busca">
        <input type="text" id="campoBusca" placeholder="Buscar por nome ou código..." oninput="filtrarTabela()" />
    </div>

    <div class="painel">
        <table class="tabela" id="tabelaProdutos">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th>Preço</th>
                    <th>Estoque</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center; color:#888;">Nenhum produto cadastrado.</td>
                    </tr>
                }
                @foreach (var produto in Model)
                {
                    <tr>
                        <td>PRD-@produto.Id.ToString("D3")</td>
                        <td>@produto.Nome</td>
                        <td>@(produto.CategoriaNome ?? "—")</td>
                        <td>R$ @produto.Preco.ToString("N2")</td>
                        <td class="@(produto.Estoque <= 5 && produto.Estoque > 0 ? "estoque-baixo" : "")">@produto.Estoque</td>
                        <td><span class="status @produto.StatusEstoque">@produto.StatusEstoqueLabel</span></td>
                        <td>
                            <button class="btn-acao editar" onclick="abrirModalEditar(@produto.Id)">Editar</button>
                            <form method="post" asp-action="Excluir" asp-route-id="@produto.Id" style="display:inline"
                                  onsubmit="return confirm('Excluir produto @produto.Nome?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-acao excluir">Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- Modal de Cadastro -->
<div class="modal-overlay" id="modalProduto">
    <div class="modal">
        <div class="modal-header">
            <h2>Novo Produto</h2>
            <button type="button" class="modal-fechar" onclick="fecharModal()">×</button>
        </div>

        <form method="post" asp-action="Salvar">
            @Html.AntiForgeryToken()

            <div class="form-grupo">
                <label>Nome do Produto</label>
                <input type="text" name="Nome" placeholder="Ex: Notebook Dell Inspiron" />
            </div>

            <div class="form-grupo">
                <label>Descrição</label>
                <textarea name="Descricao" placeholder="Descreva o produto..."></textarea>
            </div>

            <div class="form-linha">
                <div class="form-grupo">
                    <label>Preço (R$)</label>
                    <input type="number" name="Preco" placeholder="0,00" step="0.01" />
                </div>
                <div class="form-grupo">
                    <label>Quantidade em Estoque</label>
                    <input type="number" name="Estoque" placeholder="0" />
                </div>
            </div>

            <div class="form-linha">
                <div class="form-grupo">
                    <label>ID da Categoria</label>
                    <input type="number" name="IdCategoria" placeholder="Ex: 1" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancelar" onclick="fecharModal()">Cancelar</button>
                <button type="submit" class="btn-salvar">Salvar Produto</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal de Edição -->
<div class="modal-overlay" id="modalEditar">
    <div class="modal">
        <div class="modal-header">
            <h2>Editar Produto</h2>
            <button type="button" class="modal-fechar" onclick="fecharModalEditar()">×</button>
        </div>

        <form method="post" asp-action="Atualizar">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editarId" />

            <div class="form-grupo">
                <label>Nome do Produto</label>
                <input type="text" name="Nome" id="editarNome" />
            </div>

            <div class="form-grupo">
                <label>Descrição</label>
                <textarea name="Descricao" id="editarDescricao"></textarea>
            </div>

            <div class="form-linha">
                <div class="form-grupo">
                    <label>Preço (R$)</label>
                    <input type="number" name="Preco" id="editarPreco" step="0.01" />
                </div>
                <div class="form-grupo">
                    <label>Quantidade em Estoque</label>
                    <input type="number" name="Estoque" id="editarEstoque" />
                </div>
            </div>

            <div class="form-linha">
                <div class="form-grupo">
                    <label>ID da Categoria</label>
                    <input type="number" name="IdCategoria" id="editarIdCategoria" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancelar" onclick="fecharModalEditar()">Cancelar</button>
                <button type="submit" class="btn-salvar">Salvar Alterações</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModal() {
            document.getElementById('modalProduto').classList.add('aberto');
        }
        function fecharModal() {
            document.getElementById('modalProduto').classList.remove('aberto');
        }
        document.getElementById('modalProduto').addEventListener('click', function (e) {
            if (e.target === this) fecharModal();
        });

        function abrirModalEditar(id) {
            fetch(`/Produtos/Editar/${id}`)
                .then(r => r.json())
                .then(p => {
                    document.getElementById('editarId').value          = p.id;
                    document.getElementById('editarNome').value        = p.nome;
                    document.getElementById('editarDescricao').value   = p.descricao ?? '';
                    document.getElementById('editarPreco').value       = p.preco;
                    document.getElementById('editarEstoque').value     = p.estoque;
                    document.getElementById('editarIdCategoria').value = p.idCategoria ?? '';
                    document.getElementById('modalEditar').classList.add('aberto');
                });
        }
        function fecharModalEditar() {
            document.getElementById('modalEditar').classList.remove('aberto');
        }
        document.getElementById('modalEditar').addEventListener('click', function (e) {
            if (e.target === this) fecharModalEditar();
        });

        function filtrarTabela() {
            const termo = document.getElementById('campoBusca').value.toLowerCase();
            const linhas = document.querySelectorAll('#tabelaProdutos tbody tr');
            linhas.forEach(linha => {
                linha.style.display = linha.textContent.toLowerCase().includes(termo) ? '' : 'none';
            });
        }
    </script>
}