<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DbsErpMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DbsErpMobile.Views"
    Title="DBS ERP"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="#0B1F3A"
    FlyoutWidth="280">

    <FlyoutItem
        Title="Clientes"
        Route="Clientes"
        FlyoutDisplayOptions="AsSingleItem">

        <ShellContent
            Title="Clientes"
            Route="ClienteListPage"
            ContentTemplate="{DataTemplate views:ClienteListPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Produtos"
        Route="Produtos"
        FlyoutDisplayOptions="AsSingleItem">

        <ShellContent
            Title="Produtos"
            Route="ProdutoListPage"
            ContentTemplate="{DataTemplate views:ProdutoListPage}" />
    </FlyoutItem>

    <FlyoutItem
        Title="Vendas do dia"
        Route="VendasDia"
        FlyoutDisplayOptions="AsSingleItem">

        <ShellContent
            Title="Vendas do dia"
            Route="VendasDiaPage"
            ContentTemplate="{DataTemplate views:VendasDiaPage}" />
    </FlyoutItem>

</Shell>
