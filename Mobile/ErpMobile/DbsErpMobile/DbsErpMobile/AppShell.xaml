<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DbsErpMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DbsErpMobile"
    xmlns:views="clr-namespace:DbsErpMobile.Views"
    Title="DbsErpMobile">

    <TabBar>

        <ShellContent
            Title="Produtos"
            ContentTemplate="{DataTemplate views:ProdutoListPage}"
            Route="ProdutoListPage" />

        <ShellContent
            Title="Clientes"
            ContentTemplate="{DataTemplate views:ClienteListPage}"
            Route="ClienteListPage" />

    </TabBar>

</Shell>
