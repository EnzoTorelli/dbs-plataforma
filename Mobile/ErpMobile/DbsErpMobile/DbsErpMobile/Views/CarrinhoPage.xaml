<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DbsErpMobile.Views.CarrinhoPage"
             Title="Carrinho">

    <Grid RowDefinitions="*, Auto" Padding="15">

        <CollectionView x:Name="ItensCollectionView" Grid.Row="0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding NomeProduto}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Quantidade, StringFormat='Qtd: {0}'}" FontSize="12" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" 
                               Text="{Binding Subtotal, StringFormat='R$ {0:F2}'}" 
                               VerticalOptions="Center" 
                               FontAttributes="Bold" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="1" Spacing="10" Margin="0,15,0,0">
            <Label x:Name="TotalLabel" FontSize="20" FontAttributes="Bold" HorizontalOptions="End" />
            <Button Text="Finalizar Pedido" Clicked="OnFinalizarClicked" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>