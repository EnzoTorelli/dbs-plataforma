<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DbsErpMobile.Views.RevisaoPedidoPage"
    BackgroundColor="#F4F7FB"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#0B1F3A"
            Padding="20,18,20,16"
            RowDefinitions="Auto,Auto">

            <Label
                Text="DBS ERP"
                Grid.Row="0"
                HorizontalOptions="Center"
                TextColor="White"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,4,0,18" />

            <VerticalStackLayout
                Grid.Row="1"
                Spacing="2">

                <Label
                    Text="Revisão do pedido"
                    TextColor="#9CCBFF"
                    FontSize="14" />

                <Label
                    Text="Confira os dados antes de enviar"
                    TextColor="White"
                    FontSize="21"
                    FontAttributes="Bold" />

            </VerticalStackLayout>

        </Grid>

        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20,24,20,30"
                Spacing="16">

                <!-- CLIENTE -->
                <Border
                    BackgroundColor="White"
                    Stroke="#DCE3EC"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="CLIENTE"
                            TextColor="#8A94A6"
                            FontSize="11"
                            FontAttributes="Bold" />

                        <Label
                            x:Name="NomeClienteLabel"
                            Text="Cliente"
                            TextColor="#0B1F3A"
                            FontSize="17"
                            FontAttributes="Bold" />

                        <Label
                            x:Name="CpfClienteLabel"
                            Text="CPF/CNPJ"
                            TextColor="#718096"
                            FontSize="13" />

                    </VerticalStackLayout>

                </Border>

                <!-- PRODUTOS -->
                <Border
                    BackgroundColor="White"
                    Stroke="#DCE3EC"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="PRODUTOS"
                            TextColor="#8A94A6"
                            FontSize="11"
                            FontAttributes="Bold" />

                        <CollectionView
                            x:Name="ItensCollectionView"
                            SelectionMode="None">

                            <CollectionView.ItemTemplate>

                                <DataTemplate>

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        Padding="0,7">

                                        <VerticalStackLayout
                                            Grid.Column="0"
                                            Spacing="2">

                                            <Label
                                                Text="{Binding NomeProduto}"
                                                TextColor="#0B1F3A"
                                                FontSize="14"
                                                FontAttributes="Bold" />

                                            <Label
                                                Text="{Binding Quantidade, StringFormat='Quantidade: {0}'}"
                                                TextColor="#718096"
                                                FontSize="12" />

                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Subtotal, StringFormat='R$ {0:F2}'}"
                                            TextColor="#0B1F3A"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center" />

                                    </Grid>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Border>

                <!-- PAGAMENTO -->
                <Border
                    BackgroundColor="White"
                    Stroke="#DCE3EC"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="PAGAMENTO"
                            TextColor="#8A94A6"
                            FontSize="11"
                            FontAttributes="Bold" />

                        <Label
                            x:Name="PagamentoLabel"
                            Text="Não selecionado"
                            TextColor="#0B1F3A"
                            FontSize="17"
                            FontAttributes="Bold" />

                        <Label
                            Text="A condição de pagamento será enviada para validação."
                            TextColor="#718096"
                            FontSize="12" />

                    </VerticalStackLayout>

                </Border>

                <!-- TOTAL -->
                <Border
                    BackgroundColor="White"
                    Stroke="#DCE3EC"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="TOTAL DO PEDIDO"
                            TextColor="#718096"
                            FontSize="14"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="TotalLabel"
                            Grid.Column="1"
                            Text="R$ 0,00"
                            TextColor="#0B1F3A"
                            FontSize="22"
                            FontAttributes="Bold" />

                    </Grid>

                </Border>

                <!-- AVISO -->
                <Border
                    BackgroundColor="#EAF4FF"
                    Stroke="#BBDDFB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">

                    <VerticalStackLayout Spacing="5">

                        <Label
                            Text="Antes de enviar"
                            TextColor="#0B1F3A"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Label
                            Text="Após o envio, o pedido deverá ser validado pelo vendedor ou responsável interno antes da finalização."
                            TextColor="#4A5A6A"
                            FontSize="12" />

                    </VerticalStackLayout>

                </Border>

                <!-- BOTÃO -->
                <Button
                    Text="Enviar pedido para validação"
                    BackgroundColor="#1E88E5"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="14"
                    Margin="0,6,0,0"
                    Clicked="OnEnviarClicked" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
