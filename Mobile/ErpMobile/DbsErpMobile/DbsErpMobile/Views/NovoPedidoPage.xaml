<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DbsErpMobile.Views.NovoPedidoPage"
    BackgroundColor="#F4F7FB"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#0B1F3A"
            Padding="20,18,20,16"
            RowDefinitions="Auto,Auto">

            <Label
                Text="DBS ERP"
                Grid.Row="0"
                HorizontalOptions="Center"
                TextColor="White"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,4,0,18" />

            <VerticalStackLayout
                Grid.Row="1"
                Spacing="2">

                <Label
                    Text="Novo pedido"
                    TextColor="#9CCBFF"
                    FontSize="14" />

                <Label
                    Text="Cliente selecionado"
                    TextColor="White"
                    FontSize="21"
                    FontAttributes="Bold" />

            </VerticalStackLayout>

        </Grid>

        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20,24,20,30"
                Spacing="18">

                <!-- CLIENTE -->
                <Border
                    BackgroundColor="White"
                    Stroke="#DCE3EC"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="CLIENTE"
                            TextColor="#718096"
                            FontSize="12"
                            FontAttributes="Bold" />

                        <Label
                            x:Name="NomeClienteLabel"
                            TextColor="#0B1F3A"
                            FontSize="21"
                            FontAttributes="Bold" />

                        <Label
                            x:Name="CpfClienteLabel"
                            TextColor="#718096"
                            FontSize="14" />

                        <Label
                            x:Name="TelefoneClienteLabel"
                            TextColor="#8A94A6"
                            FontSize="13" />

                    </VerticalStackLayout>

                </Border>

                <!-- ETAPA -->
                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="Itens do pedido"
                        TextColor="#0B1F3A"
                        FontSize="22"
                        FontAttributes="Bold" />

                    <Label
                        Text="Adicione os produtos que o cliente deseja comprar."
                        TextColor="#718096"
                        FontSize="13" />

                </VerticalStackLayout>

                <!-- BOTÃO -->
                <Button
                    Text="Adicionar produtos"
                    BackgroundColor="#1E88E5"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="54"
                    CornerRadius="14"
                    Clicked="OnAdicionarProdutosClicked" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
