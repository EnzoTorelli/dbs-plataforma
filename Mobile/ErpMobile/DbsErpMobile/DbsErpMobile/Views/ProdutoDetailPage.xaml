<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DbsErpMobile.Views.ProdutoDetailPage"
    BackgroundColor="#F4F7FB"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- CABEÇALHO -->
        <Grid
            Grid.Row="0"
            BackgroundColor="#0B1F3A"
            Padding="20,18,20,16">

            <!-- Espaço reservado para a logo -->
            <Label
                Text="DBS ERP"
                HorizontalOptions="Center"
                TextColor="White"
                FontSize="22"
                FontAttributes="Bold" />

        </Grid>

        <!-- CONTEÚDO -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20,24,20,30"
                Spacing="18">

                <!-- TÍTULO DA PÁGINA -->
                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="Detalhes do produto"
                        TextColor="#0B1F3A"
                        FontSize="25"
                        FontAttributes="Bold" />

                    <Label
                        Text="Confira as informações antes de adicionar ao carrinho"
                        TextColor="#718096"
                        FontSize="13" />

                </VerticalStackLayout>

                <!-- CARD DO PRODUTO -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E5EAF0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="20">

                    <VerticalStackLayout Spacing="18">

                        <!-- IMAGEM / PLACEHOLDER -->
                        <Border
                            HeightRequest="180"
                            BackgroundColor="#EAF4FF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18">

                            <Label
                                Text="📦"
                                FontSize="70"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                        </Border>

                        <!-- INFORMAÇÕES -->
                        <VerticalStackLayout Spacing="7">

                            <Label
                                x:Name="NomeLabel"
                                TextColor="#0B1F3A"
                                FontSize="24"
                                FontAttributes="Bold" />

                            <Label
                                x:Name="DescricaoLabel"
                                TextColor="#718096"
                                FontSize="14" />

                        </VerticalStackLayout>

                        <!-- DIVISOR -->
                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#EDF1F5" />

                        <!-- PREÇO -->
                        <VerticalStackLayout Spacing="2">

                            <Label
                                Text="Preço"
                                TextColor="#8A94A6"
                                FontSize="12" />

                            <Label
                                x:Name="PrecoLabel"
                                TextColor="#0B1F3A"
                                FontSize="28"
                                FontAttributes="Bold" />

                        </VerticalStackLayout>

                        <!-- ESTOQUE -->
                        <Border
                            BackgroundColor="#EAF4FF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,9">

                            <Label
                                x:Name="EstoqueLabel"
                                TextColor="#1E88E5"
                                FontSize="13"
                                FontAttributes="Bold"
                                HorizontalOptions="Center" />

                        </Border>

                    </VerticalStackLayout>

                </Border>

                <!-- QUANTIDADE -->
                <Border
                    BackgroundColor="White"
                    Stroke="#E5EAF0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="18">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="Quantidade"
                            TextColor="#0B1F3A"
                            FontSize="16"
                            FontAttributes="Bold" />

                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="18">

                            <!-- DIMINUIR -->
                            <Border
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="#EAF4FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnDiminuirClicked" />
                                </Border.GestureRecognizers>

                                <Label
                                    Text="−"
                                    TextColor="#1E88E5"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <!-- QUANTIDADE -->
                            <Border
                                WidthRequest="70"
                                HeightRequest="48"
                                BackgroundColor="#0B1F3A"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">

                                <Label
                                    x:Name="QuantidadeLabel"
                                    Text="1"
                                    TextColor="White"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <!-- AUMENTAR -->
                            <Border
                                WidthRequest="48"
                                HeightRequest="48"
                                BackgroundColor="#EAF4FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnAumentarClicked" />

                                </Border.GestureRecognizers>

                                <Label
                                    Text="+"
                                    TextColor="#1E88E5"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- BOTÃO ADICIONAR -->
                <Border
                    BackgroundColor="#1E88E5"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    HeightRequest="58">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnAdicionarClicked" />
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="10">

                        <Label
                            Text="🛒"
                            FontSize="20"
                            VerticalOptions="Center" />

                        <Label
                            Text="Adicionar ao Carrinho"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                    </HorizontalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>